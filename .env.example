# Telegram — токен от @BotFather
BOT_TOKEN=
# Telegram ID владельца (узнать: написать боту @userinfobot). Сюда приходят заявки на связь.
# Владелец должен хотя бы раз нажать /start в этом боте, иначе Telegram не даст боту написать ему.
ADMIN_ID=

# air.fail — основной провайдер для чата
AIRFAIL_API_KEY=
AIRFAIL_BASE_URL=https://api.air.fail/public/text/dola_seed
AIRFAIL_MODEL=seed-2-1-turbo
AIRFAIL_TIMEOUT=120

# Файл базы данных SQLite с корзинами и заказами (необязательно; по умолчанию data/bot.db)
# DATABASE_PATH=data/bot.db

# ЮKassa: ключи тестового магазина (из личного кабинета; в git не попадают, держать только в .env)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Куда вернётся клиент после оплаты
YOOKASSA_RETURN_URL=https://t.me/personalmaster_bot
