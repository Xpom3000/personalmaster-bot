# Telegram — токен от @BotFather
BOT_TOKEN=
# Telegram ID владельца (узнать: написать боту @userinfobot). Сюда приходят заявки на связь.
# Владелец должен хотя бы раз нажать /start в этом боте, иначе Telegram не даст боту написать ему.
ADMIN_ID=

# DeepSeek — основной провайдер для чата
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=120

# Совместимость со старой локальной настройкой Ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=120

# Файл базы данных SQLite с корзинами и заказами (необязательно; по умолчанию data/bot.db)
# DATABASE_PATH=data/bot.db

# ЮKassa: ключи тестового магазина
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://example.com/payments/return
