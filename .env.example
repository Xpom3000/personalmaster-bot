# Telegram — токен от @BotFather
BOT_TOKEN=
# Telegram ID владельца (узнать: написать боту @userinfobot). Сюда приходят заявки на связь.
# Владелец должен хотя бы раз нажать /start в этом боте, иначе Telegram не даст боту написать ему.
ADMIN_ID=

# Ollama — локальный сервер нейросети
# Адрес OpenAI-совместимого API (по умолчанию Ollama слушает порт 11434)
OLLAMA_BASE_URL=http://localhost:11434/v1
# Модель, которую вы скачали командой: ollama pull <имя>
OLLAMA_MODEL=qwen2.5:7b
# Сколько секунд ждать ответ модели (локальные модели медленнее облачных)
OLLAMA_TIMEOUT=120
